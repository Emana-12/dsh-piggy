{
  "description": "把 Agent 工作状态映射到绑定的桌面小猪；只传统一事件类别与成功状态。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "通知小猪开始工作"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "通知小猪正在工作"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "通知小猪等待你的确认"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "记录小猪的工作成长"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "记录小猪的工作成长"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/work-event.js\"",
            "async": true,
            "timeout": 2,
            "statusMessage": "通知小猪工作已中断"
          }
        ]
      }
    ]
  }
}
